# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Settings)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Supabase Configuration (for fetching portfolio knowledge base & JWKS validation)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_WEBHOOK_SECRET=your_supabase_webhook_secret_here

# Admin Emails (comma-separated list of emails allowed to upload files & use admin tools)
ADMIN_EMAILS=admin@yourdomain.com

# Admin GitHub Handles / Usernames (comma-separated list for GitHub OAuth logins)
ADMIN_USERNAMES=your_github_username

# Admin Roles in Supabase (comma-separated list)
ADMIN_ROLES=admin,service_role

# Environment
ENVIRONMENT=development

